# ---------- Public site (production) ----------
# Hostname Cloudflare + NPM will serve (no scheme)
WP_DOMAIN=mydev.construwx.in
WP_SCHEME=https
# Set true to run construwx-set-domain automatically after DB is ready
CONSTRUWX_RUN_DOMAIN_CUTOVER=false

# ---------- Database (must match restored datadir / wp-config) ----------
DB_NAME=construwx
DB_USER=construwx
DB_PASSWORD=change_this
DB_ROOT_PASSWORD=change_this_root

# Table prefix used by set-domain SQL fallbacks (this site uses cnet_)
WP_DB_PREFIX=cnet_

# ---------- Timezone ----------
TZ=America/Denver

# ---------- Redis (optional; appliance Redis has no requirepass by default) ----------
REDIS_PASSWORD=change_this_redis
